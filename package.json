{
  "name": "forgepod",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "plugin:setup": "python3 -m venv plugins/beam-mcp/.venv && plugins/beam-mcp/.venv/bin/pip install -q -r plugins/beam-mcp/requirements.txt",
    "plugin:image": "${FORGEPOD_CONTAINER_RUNTIME:-docker} build -t forgepod/beam-mcp:0.1.0 plugins/beam-mcp"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "kysely": "^0.29.5",
    "next": "^16.3.2",
    "openai": "^7.5.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@types/bun": "^1.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "^5"
  }
}
