# Copy to .env and edit. Nothing here is read at build time, only when the server runs.

# Where data goes. SQLite needs no server; a postgres:// URL uses Postgres instead.
# The relative path is resolved against the working directory, and the production
# server starts from .next/standalone, so set an absolute path for any deployment.
FORGEPOD_DATABASE_URL=file:forgepod.db

# Signs every session. Required, no default. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Who answers. Leave FORGEPOD_BASE_URL unset to talk to Anthropic directly with
# ANTHROPIC_API_KEY. Set it to an OpenAI-compatible gateway to use that instead,
# with FORGEPOD_API_KEY.
# FORGEPOD_BASE_URL=https://opencode.ai/zen/v1
# FORGEPOD_API_KEY=
# ANTHROPIC_API_KEY=

# What an agent gets when neither its template nor the operator named a model. Leave it
# unset for claude-opus-5, which is right when talking to Anthropic directly and wrong on
# a gateway that serves no Anthropic ids.
# FORGEPOD_DEFAULT_MODEL=

# Who this install is, as far as a plugin is concerned. Generated and stored on first use
# if left unset. Set it only when something outside already names installs, such as a host
# running one per tenant.
# FORGEPOD_INSTALL_ID=

# How plugins are launched. Anything with a Docker-compatible `run` command works.
FORGEPOD_CONTAINER_RUNTIME=docker

# Where installed plugins are found. A directory holding a plugin.json is a plugin.
FORGEPOD_PLUGIN_DIR=plugins

# Where templates are found. A directory holding a template.json is a template.
# Installing one creates its agents once and then forgets it.
FORGEPOD_TEMPLATE_DIR=templates
